{
  "name": "niobium-browser",
  "version": "0.1.0",
  "description": "A Chromium-based desktop browser built with Electron",
  "main": "src/main.js",
  "author": "Niobium Browser contributors",
  "license": "MIT",
  "scripts": { "start": "electron .", "pack": "electron-builder --dir", "dist": "electron-builder" },
  "devDependencies": { "electron": "^39.0.0", "electron-builder": "^26.0.12" },
  "build": {
    "appId": "dev.niobium.browser",
    "productName": "Niobium",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "assets/icon.svg", "package.json"],
    "asar": true,
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": { "target": ["AppImage", "deb"], "category": "Network;WebBrowser;" },
    "mac": { "target": ["dmg"], "category": "public.app-category.productivity" }
  }
}
